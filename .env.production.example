# ZAIEZE — variáveis de produção. Copie para .env no servidor e preencha.
#   cp .env.production.example .env  &&  nano .env
# NUNCA versione o .env (já está no .gitignore).

# ── PostgreSQL (usado pelo container db e pela DATABASE_URL) ──
POSTGRES_USER=zaieze
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=zaieze

# Host = nome do serviço do compose (db). Mantenha user/senha/db iguais aos de cima.
DATABASE_URL=postgresql://zaieze:troque-por-uma-senha-forte@db:5432/zaieze?schema=public

# ── App ──
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
PORT=3050
HOST=0.0.0.0

# Multi-tenant wildcard
DOMINIO_BASE=zaieze.com
TENANT_SCHEME=https
# Origem do front (mesma origem em prod; ajuste se usar domínio à parte)
CORS_ORIGIN=https://zaieze.com

# ── Mercado Pago (Assinaturas) ──
# Sem este token o checkout roda em modo simulado. Cole o Access Token de PRODUÇÃO (APP_USR-...).
MERCADOPAGO_ACCESS_TOKEN=

# ── Integrações opcionais ──
# ANTHROPIC_API_KEY=sk-ant-...
# WhatsApp Cloud API (Meta): credenciais (WABA/número) ficam por marca (no painel).
# Aqui só os parâmetros globais:
# META_API_VERSION=v21.0
WA_TOKEN_SECRET=    # chave p/ criptografar o token da WABA (ex.: openssl rand -base64 32)
