# Integrações opcionais — sem estas chaves o sistema opera em "modo simulado"
# WhatsApp Cloud API (Meta): credenciais (WABA/número) ficam por marca (Rede.wa*, no painel).
# META_API_VERSION="v21.0"
# WA_TOKEN_SECRET="..."   # chave p/ criptografar o token da WABA (openssl rand -base64 32)
# ANTHROPIC_API_KEY="sk-ant-..."

# Billing SaaS (Mercado Pago Assinaturas/preapproval). Sem token, o checkout é simulado.
# MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."

# Multi-tenant wildcard: cada rede vive em <slug>.DOMINIO_BASE
DOMINIO_BASE=zaieze.com
# http em dev, https em produção
TENANT_SCHEME=https
