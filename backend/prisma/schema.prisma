// ModaCRM AI — Schema multi-tenant
// Hierarquia: Rede (marca) → Gestor → Lojas → Gerente → Equipes → Vendedoras
// Tenant raiz = Rede. Plano do SaaS aplicado por Rede (Elite = multi-lojas).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Plano {
  START // operação completa + WhatsApp + operação em rede
  PRO // + carteira inteligente, comissão/ranking, estoque inteligente
  ELITE // + Radar, Provador, Atacado, IA avançada, Portal do Cliente
}

enum StatusAssinatura {
  PENDENTE // checkout iniciado, aguardando aprovação do pagamento
  ATIVA // pagamento aprovado (ou assinatura simulada)
  CANCELADA // cancelada/inadimplente
}

// Add-ons: recursos vendidos À PARTE de qualquer plano (START/PRO/ELITE) — a rede assina
// independente do plano em que está. Cada tipo tem sua própria recorrência no Mercado Pago.
enum TipoAddon {
  PROVADOR // Provador Virtual (FASHN AI — try-on de foto e vídeo)
}

enum StatusAddon {
  PENDENTE // checkout iniciado, aguardando aprovação do pagamento
  ATIVA
  CANCELADA
}

enum Periodicidade {
  MENSAL
  ANUAL // cobrança 1x/ano, com desconto (ConfigAssinatura.percentualDescontoAnual)
}

enum Role {
  SUPER_ADMIN // operador do SaaS
  GESTOR // dono da marca/rede: cria lojas e denomina gerentes
  ESTOQUISTA // rede: lança entradas de produção e distribui/ajusta estoque das lojas
  GERENTE // gerencia uma loja: constrói equipes e vendedoras
  VENDEDORA // atende a própria carteira; vê só o próprio relatório
  CLIENTE // portal do cliente (fase 7)
  AFILIADO // parceiro comercial: renda recorrente por indicação, sem rede/loja
  ASSESSORA // assessor(a) de moda: representa marcas (dentro ou fora do ZAIEZE) no subdomínio próprio dela, sem rede/loja
}

enum StatusComissao {
  PENDENTE // ciclo confirmado, aguardando repasse manual (Pix) pelo admin
  PAGA
}

enum SegmentoCliente {
  NOVO // primeira compra
  FREQUENTE // compra todo mês
  VIP // > R$ 3.000 acumulado
  INATIVO // 90+ dias sem compra
  ATACADO // volume acima do limite configurado na loja
}

enum StatusVenda {
  CONCLUIDA
  CANCELADA
}

// Pedido de reserva: a peça esgotou (ou o estoque disponível no canal é insuficiente) mas o
// cliente quer aquela variação mesmo assim — vira demanda programada para a fábrica produzir.
enum StatusPedidoReserva {
  PENDENTE // aguardando reposição de estoque
  DISPONIVEL // a entrada de produção já cobre a quantidade; aguardando confirmação (vira Venda)
  CONVERTIDO // confirmado — virou Venda (ver vendaId)
  CANCELADO
}

// Orçamento: a vendedora monta uma proposta para o cliente aprovar (ou pedir alterações) pelo
// link público, ANTES de virar venda de fato — não reserva nem baixa estoque (senão seria uma
// venda fechada, ou uma reserva de peça sem pagamento). Só quando o cliente aprova é que abate
// estoque e vira Venda (o gestor de estoque separa pelo fluxo normal de "Pedidos a separar").
enum StatusOrcamento {
  RASCUNHO // a vendedora ainda está montando (ou reabriu após alteração pedida)
  AGUARDANDO_APROVACAO_DESCONTO // desconto pedido acima do limite livre — represado até o gerente decidir
  ENVIADO // link mandado ao cliente, aguardando resposta
  ALTERACAO_SOLICITADA // cliente pediu mudanças (ver mensagemCliente) — vendedora edita e reenvia
  CONVERTIDO // cliente aprovou e virou Venda (ver vendaId)
  CANCELADO
}

// Canal da venda — o foco do produto é a "venda online" (atendimento da vendedora pelo WhatsApp)
enum CanalVenda {
  BALCAO // venda presencial na loja física
  ONLINE // venda online = atendimento/fechamento pelo WhatsApp
}

// Apenas categorização da venda (não há processamento financeiro/recebíveis):
// serve para analisar o mix de vendas por vendedora/loja por tipo de recebimento.
enum FormaRecebimento {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  OUTRO
}

enum Genero {
  FEMININO
  MASCULINO
  UNISSEX
  INFANTIL
}

enum DirecaoMensagem {
  ENVIADA // loja → cliente
  RECEBIDA // cliente → loja (webhook Evolution)
}

enum StatusMensagem {
  SIMULADA // gerada sem a Cloud API da Meta configurada (modo dev)
  ENVIADA // aceita pela Cloud API (sent)
  ENTREGUE // entregue ao aparelho do cliente (delivered)
  LIDA // lida pelo cliente (read)
  FALHA // erro no envio
  RECEBIDA // mensagem recebida do cliente
}

enum OrigemMensagem {
  MANUAL // disparo individual
  CAMPANHA // disparo de campanha por segmento
  REGUA // régua de inatividade
  ENTRADA // recebida do cliente
}

enum EscopoComissao {
  PRODUTO // regra para um produto específico
  CATEGORIA // regra por categoria
  MARCA // regra por marca
  PADRAO // fallback da loja
}

enum TipoMovimentoEstoque {
  ENTRADA // recebimento de mercadoria
  SAIDA_VENDA // baixa automática por venda
  AJUSTE // correção manual / inventário
  DEVOLUCAO // retorno ao estoque
  TRANSFERENCIA_SAIDA // saída por transferência para outra loja
  TRANSFERENCIA_ENTRADA // entrada por transferência recebida
}

// Ciclo de vida da coleção: a estoquista monta em preparação e LIBERA para todas
// as vendedoras ao mesmo tempo (competição justa pelo estoque compartilhado).
enum StatusColecao {
  EM_PREPARACAO // estoquista ainda cadastrando — invisível para vendedoras e catálogo
  LIBERADA // liberada simultaneamente; aparece no PDV e no catálogo público
}

// Etapas do funil de uma OPORTUNIDADE (ciclo de contato). Um mesmo cliente pode ter
// vários ciclos ao longo do tempo: perdeu hoje, reentra depois = novo ciclo (novo Lead).
enum StatusLead {
  ENTROU // entrou pelo catálogo; aguardando a 1ª resposta (SLA de entrada correndo)
  ATENDIDO // a vendedora respondeu (fechou o SLA de entrada)
  NEGOCIANDO // atendimento ativo / negociação em andamento
  CONVERTIDO // virou venda (automático pela venda ou manual)
  PERDIDO // ciclo encerrado sem compra (cliente pode reentrar = novo ciclo)
}

enum OrigemLead {
  CATALOGO // entrou pelo link do catálogo da vendedora
}

// Provador virtual (módulo 13 — Elite). Ciclo de vida de um "look": a vendedora gera o
// link, o cliente envia a selfie (consentimento LGPD), e a FASHN gera a foto (try-on) e,
// opcionalmente, o vídeo (image-to-video). Processado por uma fila no banco (worker poller).
enum StatusProvador {
  AGUARDANDO_FOTO // link criado; aguardando o cliente enviar a selfie
  PENDENTE // selfie recebida + consentida; na fila para o try-on
  PROCESSANDO_FOTO // chamando a FASHN (try-on)
  FOTO_PRONTA // foto gerada; segue para o vídeo quando solicitado
  PROCESSANDO_VIDEO // chamando a FASHN (image-to-video)
  CONCLUIDO // foto (e vídeo) prontos
  FALHOU // erro na geração (ver campo `erro`)
  EXPIRADO // link venceu sem o cliente enviar a foto
}

// ─────────────────────────── Rede (marca) — tenant raiz ───────────────────────────

model Rede {
  id                       String   @id @default(cuid())
  nome                     String // nome da marca
  slug                     String   @unique
  plano                    Plano    @default(START)
  ativo                    Boolean  @default(true)
  // Identidade visual da marca (usada no catálogo público / Portal do Cliente)
  logoUrl                  String? // caminho do arquivo enviado pelo gestor (servido em /uploads)
  bannerUrl                String? // banner do topo do catálogo público (faixa antes dos produtos)
  // Descrição da loja escrita pelo gestor: alimenta a meta description e o schema.org (JSON-LD)
  // do catálogo público — fonte de pesquisa para buscadores e IA (GEO).
  descricaoPublica         String?
  corPrimaria              String   @default("#111111") // cor de destaque (botões/CTA)
  corSecundaria            String   @default("#ffffff") // cor de fundo
  // SLA por etapa do funil (minutos): tempo máximo do ciclo em cada etapa antes de "atrasar".
  slaEntrouMin             Int      @default(30) // 1ª resposta; estourou + auto = redistribui
  slaAtendidoMin           Int      @default(1440) // avançar do "atendido" (1 dia)
  slaNegociandoMin         Int      @default(4320) // fechar a negociação (3 dias)
  slaAutoRedistribuir      Boolean  @default(false) // redistribui sozinho quando ENTROU estoura o prazo
  // Card do funil colorido por tempo de espera: VERMELHO quando passa do SLA (atrasado);
  // LARANJA quando falta <= slaApertadoPct% do prazo; VERDE no resto.
  slaApertadoPct           Int      @default(20)
  // Canal varejo×atacado por QUANTIDADE de peças no pedido/carrinho: pedido com nº de peças
  // >= este mínimo é ATACADO (aplica preço de atacado); abaixo é VAREJO. Definido pelo gestor.
  pedidoMinimoAtacado      Int      @default(6)
  // Lote mínimo de atacado para INFANTIL (costuma ser maior, ex.: 12). Demais gêneros usam pedidoMinimoAtacado.
  pedidoMinimoInfantil     Int      @default(12)
  // Desconto no PDV: régua sugerida por total (JSON [{ate, pct}]) + limites de autorização.
  descontoRegua            Json? // null = usa a régua padrão do sistema
  descontoAutoMaxPct       Int      @default(10) // até este % a vendedora aplica sozinha
  descontoSenhaMaxPct      Int      @default(15) // acima de auto e até aqui pede senha da própria; acima pede gerente
  // Texto padrão de disparo/campanha definido pelo GESTOR para as vendedoras.
  // disparoVendedoraEditavel = a vendedora pode personalizar o texto (true) ou fica travada (false).
  textoDisparoPadrao       String?
  disparoVendedoraEditavel Boolean  @default(true)
  // WhatsApp Cloud API (oficial da Meta) — UMA WABA/número por marca. Todas as vendedoras
  // atendem por este número; a identidade da vendedora vai no conteúdo. Config manual pelo gestor.
  // Ausência de waPhoneNumberId/token → módulo opera em modo SIMULADO (não envia de verdade).
  waPhoneNumberId          String? // id do número (Graph API: {phone_number_id}/messages)
  waWabaId                 String? // id da WhatsApp Business Account
  waNumeroExibicao         String? // número legível para exibição (ex.: +55 62 9xxxx-xxxx)
  waTokenCifrado           String? // token permanente (System User), criptografado em repouso (AES-256-GCM)
  waVerifyToken            String? // token de verificação do webhook (GET hub.verify_token)
  waAppSecret              String? // segredo do app Meta p/ validar X-Hub-Signature-256 (opcional)
  waConectado              Boolean  @default(false)
  waConectadoEm            DateTime?
  // Instagram Messaging (oficial da Meta) — mesma lógica do WhatsApp: 1 conta por marca,
  // config manual pelo gestor (Business Account ID + token). Ausência → modo SIMULADO.
  // Diferente do WhatsApp, não há "template" fora da janela — só se responde a quem já
  // mandou mensagem, e só dentro de 24h (ver Cliente.igUltimaEntradaEm).
  igBusinessAccountId      String? // id da conta profissional do Instagram (Graph API)
  igPageId                 String? // Página do Facebook vinculada (opcional; Instagram Login não exige)
  igUsername               String? // @ exibido, obtido ao validar a conexão
  igTokenCifrado           String? // access token, cifrado em repouso (mesmo AES-256-GCM do WhatsApp)
  igVerifyToken            String? // token de verificação do webhook (GET hub.verify_token)
  igAppSecret              String? // segredo do app Meta p/ validar X-Hub-Signature-256 (opcional)
  igConectado              Boolean  @default(false)
  igConectadoEm            DateTime?
  // Meta mensal da MARCA (valor total do mês). Distribuída às lojas conforme metaModo:
  // IGUAL = meta da marca ÷ nº de lojas; MANUAL = valor definido em cada Loja.metaMensal.
  // A meta da vendedora é derivada: meta da loja ÷ nº de vendedoras ativas da loja.
  metaMensal               Decimal? @db.Decimal(12, 2)
  metaModo                 String   @default("IGUAL") // IGUAL | MANUAL
  // Programa de Afiliados: qual afiliado indicou esta rede (se veio por um link ?ref=).
  // Base do cálculo de comissão vitalícia — gravado no ato do checkout, não muda depois.
  afiliadoId               String?
  // Indicação por Assessor(a) de Moda (link próprio, ?refAssessor=<slug>): mesma mecânica de
  // comissão vitalícia do afiliado, mas para uma assessora indicar lojistas que ela conhece.
  assessorOrigemId         String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  lojas      Loja[]
  usuarios   Usuario[] // gestores da rede
  assinatura Assinatura?
  addons     AssinaturaAddon[]
  // Estoque central da fábrica/marca: coleções, produtos e taxonomias vivem no nível da REDE
  // (não por loja). As lojas apenas recebem permissão de venda via ColecaoLoja (distribuição).
  colecoes   Colecao[]
  produtos   Produto[]
  categorias Categoria[]
  marcas     Marca[]
  campanhasModelo CampanhaModelo[]
  aceitesContrato AceiteContrato[]
  afiliadoOrigem Afiliado? @relation(fields: [afiliadoId], references: [id], onDelete: SetNull)
  assessorOrigem Assessor? @relation(fields: [assessorOrigemId], references: [id], onDelete: SetNull)
  looksProvador   LookProvador[]
  assessorMarcas  AssessorMarca[]

  @@map("redes")
}

/// Registro de aceite eletrônico do contrato de prestação de serviços (assinado
/// pelo GESTOR em nome da rede). Prova jurídica: quem, quando, IP e versão —
/// art. 10, §2º da MP 2.200-2/2001. Cada nova versão do contrato gera novo aceite.
model AceiteContrato {
  id             String   @id @default(cuid())
  redeId         String
  versao         String // versão do contrato aceita
  idioma         String   @default("pt") // idioma exibido no momento do aceite (auditoria) — não afeta a lógica de reaceite/distrato, que segue só por versao
  assinanteNome  String   @map("assinante_nome")
  assinanteEmail String   @map("assinante_email")
  ip             String?
  userAgent      String?  @map("user_agent")
  aceitoEm       DateTime @default(now()) @map("aceito_em")

  rede Rede @relation(fields: [redeId], references: [id], onDelete: Cascade)

  @@index([redeId, aceitoEm])
  @@map("aceites_contrato")
}

// ─────────────────────────── Billing SaaS (assinatura por rede) ───────────────────────────
// Cada rede (tenant) tem uma assinatura recorrente. Sem MERCADOPAGO_ACCESS_TOKEN, opera simulada.

model Assinatura {
  id                       String           @id @default(cuid())
  redeId                   String           @unique
  plano                    Plano
  status                   StatusAssinatura @default(PENDENTE)
  periodicidade            Periodicidade    @default(MENSAL)
  valor                    Decimal          @db.Decimal(12, 2)
  mpPreapprovalId          String? // id da assinatura no Mercado Pago (preapproval); null em modo simulado
  simulada                 Boolean          @default(false)
  // Reajustes anuais (IGP-M) já aplicados a ESTE contrato. O próximo aniversário a reajustar é
  // createdAt + (reajustesAplicados + 1) anos. Usado pelo job de reajuste por aniversário.
  reajustesAplicados       Int              @default(0)
  // Data da 1ª cobrança quando há período grátis (free trial): o MP não cobra antes disso.
  // Usada para avisar o lojista (banner) quando faltam <= 30 dias. Null = sem free trial.
  primeiraCobrancaEm       DateTime?
  // Política de cancelamento por FIM DE CICLO (vale p/ MP, lojista e admin):
  cicloFimEm               DateTime? // acesso garantido até o fim do ciclo pago vigente
  cancelamentoSolicitadoEm DateTime? // quando o cancelamento foi pedido (null = renovando normalmente)
  cancelamentoOrigem       String? // LOJISTA | ADMIN | MERCADO_PAGO (auditoria)
  // Cotação BRL→USD travada no momento da assinatura (cache do ConfigCambio no instante do
  // checkout), só para histórico/auditoria informativa — NUNCA usada para cobrança (o Mercado
  // Pago cobra 100% em BRL). Null = cotação indisponível no momento do cadastro.
  cotacaoUsdNaAssinatura   Decimal?         @db.Decimal(10, 6)
  cotacaoUsdDataFonte      DateTime?        @db.Date
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  rede Rede @relation(fields: [redeId], references: [id], onDelete: Cascade)

  @@map("assinaturas")
}

/// Assinatura de um add-on (hoje só Provador Virtual) — recorrência PRÓPRIA no Mercado Pago,
/// independente do plano/Assinatura principal. Uma rede pode ter várias (uma por tipo).
model AssinaturaAddon {
  id                       String      @id @default(cuid())
  redeId                   String
  tipo                     TipoAddon
  status                   StatusAddon @default(PENDENTE)
  valor                    Decimal     @db.Decimal(12, 2)
  mpPreapprovalId          String? // id da assinatura no Mercado Pago (preapproval); null em modo simulado
  simulada                 Boolean     @default(false)
  cicloFimEm               DateTime? // acesso garantido até o fim do ciclo pago vigente
  cancelamentoSolicitadoEm DateTime?
  cancelamentoOrigem       String? // LOJISTA | ADMIN | MERCADO_PAGO (auditoria)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  rede Rede @relation(fields: [redeId], references: [id], onDelete: Cascade)

  @@unique([redeId, tipo])
  @@map("assinaturas_addon")
}

/// Preço de cada plano (editável pelo SUPER_ADMIN no Painel do Admin, sem deploy).
/// A classificação de funcionalidades por plano continua no código (FEATURE_MIN_PLANO).
model ConfigPlano {
  plano     Plano    @id
  preco     Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @default(now()) @updatedAt

  @@map("config_planos")
}

/// Preço vigente de cada add-on (editável pelo SUPER_ADMIN) — mesmo padrão de ConfigPlano.
model ConfigAddon {
  tipo      TipoAddon @id
  preco     Decimal   @db.Decimal(12, 2)
  updatedAt DateTime  @default(now()) @updatedAt

  @@map("config_addons")
}

/// Percentual de desconto do plano ANUAL (editável pelo SUPER_ADMIN). Uma linha só (id=1),
/// mesmo padrão de ConfigAfiliados.
model ConfigAssinatura {
  id                      Int      @id @default(1)
  percentualDescontoAnual Decimal  @default(10) @db.Decimal(5, 2)
  updatedAt               DateTime @updatedAt

  @@map("config_assinatura")
}

/// Cotação BRL→USD em cache (auto-fetch diário via Frankfurter, ver cambio.service.ts), só
/// para exibição informativa no site (Mercado Pago cobra 100% em BRL). Uma linha só (id=1),
/// mesmo padrão de ConfigAssinatura. Campos nullable: antes do 1º fetch bem-sucedido (ou se a
/// API cair e nunca tiver funcionado), o site simplesmente não mostra o equivalente em dólar.
model ConfigCambio {
  id           Int       @id @default(1)
  usdPorBrl    Decimal?  @db.Decimal(10, 6) // ex.: 0.192450 = 1 BRL vale esse tanto em USD
  dataCotacao  DateTime? @db.Date // campo "date" devolvido pela Frankfurter (dia útil de referência)
  atualizadoEm DateTime  @updatedAt

  @@map("config_cambio")
}

/// Histórico de reajustes de preço (ex.: IGP-M acumulado). Auditoria do admin.
model ReajusteHistorico {
  id          String   @id @default(cuid())
  indice      String // IGP-M
  percentual  Decimal  @db.Decimal(6, 3) // % aplicado
  detalhe     Json? // { START: { de, para }, PRO: {...}, ELITE: {...} }
  aplicadoPor String? // nome/e-mail do admin
  aplicadoEm  DateTime @default(now())

  @@map("reajustes_historico")
}

/// Tabela de IGP-M acumulado (12 meses) por mês de referência, lançada pelo SUPER_ADMIN.
/// No aniversário de cada contrato, o sistema aplica a taxa do MÊS ANTERIOR ao aniversário
/// (= o 12º mês do contrato): ex. contrato de jun/2026 reajusta em jun/2027 com o índice de mai/2027.
model IndiceIgpm {
  id            String   @id @default(cuid())
  ano           Int // ano de referência (ex.: 2027)
  mes           Int // mês de referência 1..12 (ex.: 5 = maio)
  percentual    Decimal  @db.Decimal(6, 3) // IGP-M acumulado 12m (%) — pode ser negativo (deflação)
  registradoPor String? // nome do admin
  createdAt     DateTime @default(now())

  @@unique([ano, mes])
  @@map("indices_igpm")
}

/// Auditoria dos reajustes anuais aplicados a cada assinatura (por aniversário).
model ReajusteAssinatura {
  id          String   @id @default(cuid())
  redeId      String // rede reajustada (sem relação: registro de auditoria, sobrevive à rede)
  redeNome    String // snapshot do nome da marca
  ano         Int // mês de referência do índice aplicado
  mes         Int
  percentual  Decimal  @db.Decimal(6, 3)
  valorAntes  Decimal  @db.Decimal(12, 2)
  valorDepois Decimal  @db.Decimal(12, 2)
  aplicadoEm  DateTime @default(now())

  @@index([redeId])
  @@index([aplicadoEm])
  @@map("reajustes_assinatura")
}

enum TipoPromocao {
  DIAS_GRATIS // começa a pagar depois de N dias (free trial)
  PERCENTUAL // % de desconto na mensalidade
}

/// A qual assinatura o cupom se aplica — um mesmo código nunca vale para as duas.
enum AplicacaoPromo {
  REDE // assinatura de plano da loja/marca (START/PRO/ELITE)
  ASSESSOR // assinatura do Assessor(a) de Moda
}

/// Código promocional aplicado no checkout (criado pelo SUPER_ADMIN).
model CodigoPromocional {
  id          String         @id @default(cuid())
  codigo      String         @unique
  tipo        TipoPromocao
  // A qual tipo de assinatura o cupom se aplica — default REDE preserva o comportamento dos
  // cupons já existentes (todos eram, até aqui, só de plano de loja/marca).
  aplicaA     AplicacaoPromo @default(REDE)
  // Plano ao qual o cupom se aplica (oferta completa: o link fica só ?cupom=). Só relevante
  // quando aplicaA=REDE. Null = qualquer plano.
  plano       Plano?
  dias        Int? // DIAS_GRATIS: dias grátis antes da 1ª cobrança
  percentual  Decimal?       @db.Decimal(5, 2) // PERCENTUAL: % de desconto na mensalidade
  descricao   String?
  validadeAte DateTime? // último dia em que pode ser usado (null = sem prazo)
  maxUsos     Int? // limite de usos (null = ilimitado)
  usos        Int            @default(0)
  ativo       Boolean        @default(true)
  createdAt   DateTime       @default(now())

  @@map("codigos_promocionais")
}

model Loja {
  id              String   @id @default(cuid())
  redeId          String
  nome            String
  slug            String   @unique // links de catálogo: loja.com/<slug>/<vendedora>
  cnpj            String?
  telefone        String?
  ativo           Boolean  @default(true)
  // limite de volume acumulado (R$) a partir do qual o cliente é segmentado como ATACADO
  limiteAtacado   Decimal  @default(5000) @db.Decimal(12, 2)
  // % de cashback creditado ao cliente a cada compra (Portal do Cliente — fase 7). 0 = desligado.
  cashbackPercent Decimal  @default(0) @db.Decimal(5, 2)
  // Meta mensal da loja (usada quando a rede está em metaModo = MANUAL).
  metaMensal      Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rede                 Rede               @relation(fields: [redeId], references: [id], onDelete: Cascade)
  usuarios             Usuario[]
  equipes              Equipe[]
  clientes             Cliente[]
  vendas               Venda[]
  pedidosReserva       PedidoReserva[]
  orcamentos           Orcamento[]
  // Distribuição: coleções (da rede) que esta loja pode vender. Estoque é central (não por loja).
  colecoesDistribuidas ColecaoLoja[]
  campanhas            Campanha[]
  reguas               ReguaInatividade[]
  regrasComissao       RegraComissao[]
  postsMural           PostMural[]
  leads                Lead[]
  gruposTransmissao    GrupoTransmissao[]
  looksProvador        LookProvador[]

  @@index([redeId])
  @@map("lojas")
}

// ─────────────────────────── Equipes ───────────────────────────

model Equipe {
  id        String   @id @default(cuid())
  lojaId    String
  nome      String
  createdAt DateTime @default(now())

  loja       Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  vendedoras Usuario[]

  @@unique([lojaId, nome])
  @@map("equipes")
}

// ─────────────────────────── Usuários ───────────────────────────

model Usuario {
  id             String   @id @default(cuid())
  redeId         String? // GESTOR (escopo = rede inteira)
  lojaId         String? // GERENTE / VENDEDORA
  equipeId       String? // VENDEDORA (equipe do gerente)
  nome           String
  email          String   @unique
  senhaHash      String
  role           Role
  telefone       String?
  // foto de perfil da vendedora (exibida no cabeçalho do Chat Zaieze; URL no R2/local)
  fotoUrl        String?
  // slug do catálogo da vendedora: loja.com/<loja>/<slugCatalogo> (fase 6)
  slugCatalogo   String?
  // bio/apresentação exibida no cabeçalho do catálogo público (loja da vendedora)
  bioCatalogo    String?
  metaMensal     Decimal? @db.Decimal(12, 2)
  comissaoPadrao Decimal? @db.Decimal(5, 2) // % padrão da vendedora
  // Número pessoal de contato da vendedora (deep link wa.me no handoff "Falar com a vendedora").
  // NÃO é mais uma instância de envio: o envio oficial é pelo número da MARCA (Rede.wa*).
  waNumero       String?
  // Idioma preferencial da interface (pt | en | es). Escolhido no cadastro (checkout do GESTOR)
  // e editável depois em "Minha conta". Só afeta a UI — não traduz dados do usuário/catálogo.
  idioma         String   @default("pt")
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rede              Rede?              @relation(fields: [redeId], references: [id], onDelete: Cascade)
  loja              Loja?              @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  equipe            Equipe?            @relation(fields: [equipeId], references: [id], onDelete: SetNull)
  carteira          Cliente[]          @relation("CarteiraVendedora")
  vendas            Venda[]
  pedidosReserva    PedidoReserva[]
  orcamentos        Orcamento[]        @relation("OrcamentosVendedora")
  orcamentosDescontoAprovado Orcamento[] @relation("OrcamentosDescontoAprovadoPor")
  mensagens         MensagemWhatsapp[] @relation("MensagensVendedora")
  mensagensInstagram MensagemInstagram[] @relation("MensagensInstagramVendedora")
  campanhas         Campanha[]
  campanhasModelo   CampanhaModelo[]   @relation("ModelosCampanhaCriados")
  postsMural        PostMural[]
  leads             Lead[]             @relation("LeadsVendedora")
  gruposTransmissao GrupoTransmissao[] @relation("GruposVendedora")
  looksProvador     LookProvador[]     @relation("LooksProvadorCriados")
  solicitacoesSenha SolicitacaoSenha[]
  afiliado          Afiliado?
  assessor          Assessor?

  @@unique([lojaId, slugCatalogo])
  @@index([lojaId, role])
  @@map("usuarios")
}

// "Esqueci minha senha" quando o usuário não tem WhatsApp cadastrado (o caminho automático
// manda uma senha provisória pelo WhatsApp). Fica pendente até um humano atender: se quem
// pediu é GESTOR, aparece pro SUPER_ADMIN; senão, aparece pro GESTOR da própria rede.
model SolicitacaoSenha {
  id         String    @id @default(cuid())
  usuarioId  String
  atendidaEm DateTime?
  createdAt  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, atendidaEm])
  @@map("solicitacoes_senha")
}

// Convite por link: o gestor/gerente (ou super admin) convida uma pessoa; ela abre o link e
// CRIA A PRÓPRIA SENHA — só então o Usuario é criado (escopo capturado no convite). Token expira.
model Convite {
  id          String   @id @default(cuid())
  token       String   @unique
  nome        String
  email       String
  telefone    String?
  role        Role
  redeId      String?
  lojaId      String?
  equipeId    String?
  criadoPorId String?
  usado       Boolean  @default(false)
  expiraEm    DateTime
  createdAt   DateTime @default(now())

  @@index([redeId, usado])
  @@map("convites")
}

// ─────────────────────────── Clientes (CRM) ───────────────────────────

model Cliente {
  id                String          @id @default(cuid())
  lojaId            String
  vendedoraId       String? // dona da carteira; null = sem carteira definida
  nome              String
  // WhatsApp — chave de roteamento de conversas. Opcional: cliente que chega só pelo
  // Instagram (ver igScopedId) pode não ter telefone.
  telefone          String?
  email             String?
  cpf               String?
  instagram         String?
  // Endereço (para filtros de segmentação geográfica em campanhas/seleção — R1).
  // Preenchidos via CEP (ViaCEP) no cadastro; DDD é derivado do telefone.
  cep               String?
  cidade            String?
  uf                String? // sigla do estado (ex.: GO); região é derivada da UF
  segmento          SegmentoCliente @default(NOVO)
  // "Consumidor Outro": cliente coringa, 1 por loja, criado sob demanda (getOrCreate) para
  // vendas presenciais de balcão sem cadastro completo. Excluído das listagens normais de
  // carteira/segmentação (ver filtroCarteira em clientes.routes.ts).
  consumidorOutro   Boolean         @default(false)
  // agregados mantidos pelo módulo de vendas e job de segmentação (fase 3)
  totalGasto        Decimal         @default(0) @db.Decimal(12, 2)
  ultimaCompraEm    DateTime?
  // Última mensagem RECEBIDA do cliente — base da janela de 24h da Cloud API
  // (texto/mídia livre só até 24h depois; fora disso, só template aprovado).
  waUltimaEntradaEm DateTime?
  // Instagram oficial (Meta) — id da pessoa escopado à conta da marca (não é o @handle).
  // Chave de roteamento de conversas do Instagram, equivalente ao telefone no WhatsApp.
  igScopedId        String?
  // Última mensagem RECEBIDA do cliente pelo Instagram — base da janela de 24h da Graph API.
  igUltimaEntradaEm DateTime?
  // LGPD: consentimento para campanhas (WhatsApp/Custom Audiences — módulos 4, 10, 16)
  consentimentoLgpd Boolean         @default(false)
  observacoes       String?
  // Portal do Cliente (fase 7): acesso próprio do cliente + saldo de cashback acumulado
  senhaHash         String?
  saldoCashback     Decimal         @default(0) @db.Decimal(12, 2)
  ativo             Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  loja         Loja               @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  vendedora    Usuario?           @relation("CarteiraVendedora", fields: [vendedoraId], references: [id], onDelete: SetNull)
  vendas       Venda[]
  pedidosReserva PedidoReserva[]
  orcamentos   Orcamento[]
  mensagens    MensagemWhatsapp[]
  mensagensInstagram MensagemInstagram[]
  leads        Lead[]
  gruposMembro GrupoMembro[]

  @@unique([lojaId, telefone])
  @@unique([lojaId, igScopedId])
  @@index([lojaId, vendedoraId])
  @@index([lojaId, segmento])
  @@index([lojaId, consumidorOutro])
  @@map("clientes")
}

// ─────────────────────────── Leads (entrada pelo catálogo) ───────────────────────────
// O cliente acessa o link do catálogo da vendedora → é direcionado ao WhatsApp dela.
// Esse contato vira um Lead atribuído à vendedora. "Atender" = a vendedora responder.
// Se estourar o SLA (regra do gestor), o lead é redistribuído a outra vendedora.

model Lead {
  id              String     @id @default(cuid())
  lojaId          String
  vendedoraId     String // dona atual do ciclo
  clienteId       String? // vinculado quando o telefone do cliente é identificado
  nome            String?
  telefone        String?
  origem          OrigemLead @default(CATALOGO)
  status          StatusLead @default(ENTROU)
  slugCatalogo    String? // slug da vendedora que originou o ciclo (auditoria)
  produtoId       String? // peça que despertou o interesse (opcional)
  etapaDesde      DateTime   @default(now()) // quando entrou na etapa atual (tempo em etapa)
  prazoEm         DateTime // limite do SLA da etapa atual (etapaDesde + limite da etapa)
  atendidoEm      DateTime? // 1ª resposta da vendedora
  fechadoEm       DateTime? // quando foi CONVERTIDO ou PERDIDO
  motivoPerda     String?
  vendaId         String? // venda que converteu o ciclo
  redistribuidoEm DateTime?
  redistribuicoes Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  loja      Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  vendedora Usuario  @relation("LeadsVendedora", fields: [vendedoraId], references: [id], onDelete: Cascade)
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  venda     Venda?   @relation(fields: [vendaId], references: [id], onDelete: SetNull)

  @@index([lojaId, status])
  @@index([vendedoraId, status])
  @@map("leads")
}

// ─────────────────────────── Catálogo ───────────────────────────

model Categoria {
  id     String @id @default(cuid())
  redeId String
  nome   String

  rede     Rede      @relation(fields: [redeId], references: [id], onDelete: Cascade)
  produtos Produto[]

  @@unique([redeId, nome])
  @@map("categorias")
}

model Marca {
  id     String @id @default(cuid())
  redeId String
  nome   String

  rede     Rede      @relation(fields: [redeId], references: [id], onDelete: Cascade)
  produtos Produto[]

  @@unique([redeId, nome])
  @@map("marcas")
}

model Colecao {
  id                String        @id @default(cuid())
  redeId            String
  nome              String
  descricao         String?
  status            StatusColecao @default(EM_PREPARACAO)
  liberadaEm        DateTime? // quando foi liberada para as vendedoras
  validadeAte       DateTime? // data limite de vigência: após essa data a coleção some do catálogo/PDV (null = sem prazo)
  // Outlet: marcado MANUALMENTE pelo gestor (ortogonal ao status — coleção Outlet continua LIBERADA/vendável).
  outlet            Boolean       @default(false)
  outletDesde       DateTime?
  descontoOutletPct Int? // desconto % aplicado à COLEÇÃO inteira em Outlet (null = sem desconto de coleção; peça pode ter o seu)
  // Limpeza de mídia por plano: a mídia do catálogo expira em liberadaEm + retenção(plano)
  // (START 6m / PRO 12m / ELITE perpétuo). Quando apagada do R2, registra a data aqui.
  midiaExpiradaEm   DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  rede     Rede          @relation(fields: [redeId], references: [id], onDelete: Cascade)
  produtos Produto[]
  lojas    ColecaoLoja[] // distribuição: lojas que podem vender esta coleção

  @@unique([redeId, nome])
  @@index([redeId, status])
  @@map("colecoes")
}

// Distribuição da coleção (estoque central): liga uma Coleção (da rede) às Lojas que podem vendê-la.
// É só permissão de venda — não há estoque por loja. Liberação/Outlet seguem na Coleção (únicos).
model ColecaoLoja {
  id        String   @id @default(cuid())
  colecaoId String
  lojaId    String
  createdAt DateTime @default(now())

  colecao Colecao @relation(fields: [colecaoId], references: [id], onDelete: Cascade)
  loja    Loja    @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@unique([colecaoId, lojaId])
  @@index([lojaId])
  @@map("colecao_loja")
}

model Produto {
  id                String   @id @default(cuid())
  redeId            String
  // Referência do modelo (lançada pelo gestor de estoque, vinda da confecção) — base do SKU
  referencia        String?
  nome              String // nome do modelo (ex.: "Júlia")
  descricao         String?
  genero            Genero   @default(FEMININO)
  categoriaId       String? // tipo de peça (ex.: "Vestido Longo")
  marcaId           String?
  colecaoId         String? // ex.: "Verão/Primavera 2026"
  precoVarejo       Decimal  @db.Decimal(12, 2)
  precoAtacado      Decimal? @db.Decimal(12, 2)
  custo             Decimal? @db.Decimal(12, 2)
  descontoOutletPct Int? // desconto % específico desta peça em Outlet (override do desconto da coleção)
  // Opcionais de moda (usa quem quiser)
  composicao        String? // tecido/composição (ex.: "95% viscose, 5% elastano")
  modelagem         String? // caimento/fit (ex.: "evasê", "slim")
  ncm               String? // código fiscal
  fornecedor        String? // confecção/fornecedor
  pesoGramas        Int? // peso para frete/e-commerce
  faixaEtaria       String? // infantil (ex.: "4-6 anos")
  fotos             String[] @default([])
  // Cor de cada foto, alinhado por índice com `fotos` ('' = serve para todas as cores).
  // Permite trocar a galeria ao escolher a cor no catálogo.
  fotosCores        String[] @default([])
  videos            String[] @default([]) // URLs de vídeo (Cloudflare R2 / cdn.zaieze.com)
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  rede      Rede              @relation(fields: [redeId], references: [id], onDelete: Cascade)
  categoria Categoria?        @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  marca     Marca?            @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  colecao   Colecao?          @relation(fields: [colecaoId], references: [id], onDelete: SetNull)
  variacoes VariacaoProduto[]
  looksProvador LookProvador[]

  @@unique([redeId, referencia])
  @@index([redeId, ativo])
  @@map("produtos")
}

// Grade: variação = produto × cor × tamanho (SKU). Estoque vive aqui.
model VariacaoProduto {
  id            String  @id @default(cuid())
  produtoId     String
  cor           String
  estampa       String  @default("") // estampa/padronagem (ex.: Paisley, Floral); vazio = liso/sem estampa
  tamanho       String
  sku           String  @unique
  codigoBarras  String? @unique // EAN/GTIN (opcional) — leitura no PDV
  estoque       Int     @default(0)
  estoqueMinimo Int     @default(2)
  // Reserva EXCLUSIVA de varejo (subconjunto de `estoque`, peças únicas). O atacado só pode
  // usar o restante (estoque − estoqueVarejo). O gestor de estoque remaneja entre os baldes
  // ajustando este valor (0 ≤ estoqueVarejo ≤ estoque).
  estoqueVarejo Int     @default(0)

  produto    Produto            @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  itensVenda ItemVenda[]
  movimentos MovimentoEstoque[]
  pedidosReserva PedidoReserva[]
  itensOrcamento ItemOrcamento[]

  @@unique([produtoId, cor, estampa, tamanho])
  @@map("variacoes_produto")
}

// ─────────────────────────── Vendas + Estoque ───────────────────────────

model Venda {
  id               String           @id @default(cuid())
  // token público do comprovante: link sem login para o cliente abrir/imprimir o pedido
  tokenPublico     String           @unique @default(cuid())
  lojaId           String
  clienteId        String?
  vendedoraId      String
  status           StatusVenda      @default(CONCLUIDA)
  canal            CanalVenda       @default(BALCAO)
  formaRecebimento FormaRecebimento @default(DINHEIRO)
  total            Decimal          @db.Decimal(12, 2)
  desconto         Decimal          @default(0) @db.Decimal(12, 2)
  descontoPct      Decimal          @default(0) @db.Decimal(5, 2)
  atacado          Boolean          @default(false)
  // cashback creditado ao cliente nesta venda (Portal do Cliente) — base do estorno no cancelamento
  cashbackGerado   Decimal          @default(0) @db.Decimal(12, 2)
  observacao       String?
  // Separação física (gestor de estoque): pedido entra como pendente ao fechar a venda; o
  // gestor marca como separado. O gerente acompanha/cobra os pendentes na tela "Pedidos a separar".
  separado         Boolean          @default(false)
  separadoEm       DateTime?
  createdAt        DateTime         @default(now())

  loja             Loja        @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  cliente          Cliente?    @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  vendedora        Usuario     @relation(fields: [vendedoraId], references: [id])
  itens            ItemVenda[]
  leadsConvertidos Lead[]
  pedidoReserva    PedidoReserva?
  orcamento        Orcamento?

  @@index([lojaId, createdAt])
  @@index([lojaId, vendedoraId])
  @@map("vendas")
}

// Pedido de reserva (peça esgotada com demanda): a vendedora registra a intenção de compra de
// uma variação sem estoque suficiente; some da "fila normal" de venda e vira um sinal de demanda
// programada para o gestor de estoque planejar a produção. Quando a fábrica repõe o suficiente
// (POST /estoque/entrada), o(s) pedido(s) mais antigo(s) daquela variação viram DISPONIVEL; a
// confirmação (POST /reservas/:id/confirmar) cria a Venda de fato e abate o estoque.
model PedidoReserva {
  id            String              @id @default(cuid())
  lojaId        String
  clienteId     String?
  vendedoraId   String
  variacaoId    String
  quantidade    Int
  precoUnitario Decimal             @db.Decimal(12, 2)
  atacado       Boolean             @default(false)
  status        StatusPedidoReserva @default(PENDENTE)
  observacao    String?
  vendaId       String?             @unique // preenchido na confirmação (CONVERTIDO)
  disponivelEm  DateTime? // quando a reposição passou a cobrir a quantidade pedida
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  loja      Loja            @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  cliente   Cliente?        @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  vendedora Usuario         @relation(fields: [vendedoraId], references: [id])
  variacao  VariacaoProduto @relation(fields: [variacaoId], references: [id], onDelete: Cascade)
  venda     Venda?          @relation(fields: [vendaId], references: [id], onDelete: SetNull)

  @@index([lojaId, status])
  @@index([variacaoId, status])
  @@index([vendedoraId, status])
  @@map("pedidos_reserva")
}

model Orcamento {
  id                    String          @id @default(cuid())
  // token do link público (o cliente abre sem login para aprovar/pedir alteração)
  tokenPublico          String          @unique @default(cuid())
  lojaId                String
  clienteId             String
  vendedoraId           String
  status                StatusOrcamento @default(RASCUNHO)
  atacado               Boolean         @default(false)
  // desconto VIGENTE (já liberado — direto pela vendedora ou aprovado pelo gerente)
  descontoPct           Decimal         @default(0) @db.Decimal(5, 2)
  // desconto PEDIDO acima do limite livre, aguardando decisão do gerente (null = nada pendente)
  descontoSolicitadoPct Decimal?        @db.Decimal(5, 2)
  aprovadoDescontoPorId String?
  observacao            String?
  // último comentário do cliente ao pedir alteração (ALTERACAO_SOLICITADA)
  mensagemCliente       String?
  total                 Decimal         @default(0) @db.Decimal(12, 2)
  vendaId               String?         @unique // preenchido quando o cliente aprova (CONVERTIDO)
  enviadoEm             DateTime?
  respondidoEm          DateTime? // quando o cliente aprovou ou pediu alteração
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  loja                Loja            @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  cliente             Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vendedora           Usuario         @relation("OrcamentosVendedora", fields: [vendedoraId], references: [id])
  aprovadoDescontoPor Usuario?        @relation("OrcamentosDescontoAprovadoPor", fields: [aprovadoDescontoPorId], references: [id], onDelete: SetNull)
  venda               Venda?          @relation(fields: [vendaId], references: [id], onDelete: SetNull)
  itens               ItemOrcamento[]

  @@index([lojaId, status])
  @@index([clienteId])
  @@index([vendedoraId, status])
  @@map("orcamentos")
}

model ItemOrcamento {
  id            String   @id @default(cuid())
  orcamentoId   String
  variacaoId    String
  quantidade    Int
  precoUnitario Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  orcamento Orcamento       @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  variacao  VariacaoProduto @relation(fields: [variacaoId], references: [id], onDelete: Cascade)

  @@index([orcamentoId])
  @@map("itens_orcamento")
}

// Histórico de auditoria de descontos aplicados no PDV (quem, quando, %, valor, quem autorizou).
model AuditoriaDesconto {
  id                String   @id @default(cuid())
  lojaId            String
  vendaId           String?
  usuarioId         String // quem aplicou o desconto
  usuarioNome       String
  pct               Decimal  @db.Decimal(5, 2)
  valorBruto        Decimal  @db.Decimal(12, 2)
  valorDesconto     Decimal  @db.Decimal(12, 2)
  autorizadoPorId   String? // gerente/gestor que autorizou (quando exigido)
  autorizadoPorNome String?
  createdAt         DateTime @default(now())

  @@index([lojaId, createdAt])
  @@map("auditoria_desconto")
}

model ItemVenda {
  id            String  @id @default(cuid())
  vendaId       String
  variacaoId    String
  quantidade    Int
  precoUnitario Decimal @db.Decimal(12, 2)

  venda    Venda           @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  variacao VariacaoProduto @relation(fields: [variacaoId], references: [id])

  @@map("itens_venda")
}

model MovimentoEstoque {
  id         String               @id @default(cuid())
  variacaoId String
  tipo       TipoMovimentoEstoque
  quantidade Int // positivo = entra, negativo = sai
  motivo     String?
  vendaId    String? // referência da venda quando SAIDA_VENDA
  createdAt  DateTime             @default(now())

  variacao VariacaoProduto @relation(fields: [variacaoId], references: [id], onDelete: Cascade)

  @@index([variacaoId, createdAt])
  @@map("movimentos_estoque")
}

// ─────────────────────────── WhatsApp / Campanhas / Réguas ───────────────────────────

model Campanha {
  id               String           @id @default(cuid())
  lojaId           String
  criadaPorId      String
  modeloId         String? // disparo originado de uma campanha da marca (catálogo centralizado)
  nome             String
  segmentoAlvo     SegmentoCliente? // null = lista manual de clientes
  mensagemTemplate String
  templateId       String? // template HSM (Cloud API) usado no disparo; null = texto livre (janela 24h)
  // contadores do disparo
  enviados         Int              @default(0)
  simulados        Int              @default(0)
  falhas           Int              @default(0)
  semConsentimento Int              @default(0)
  createdAt        DateTime         @default(now())

  loja      Loja               @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  criadaPor Usuario            @relation(fields: [criadaPorId], references: [id])
  modelo    CampanhaModelo?    @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  mensagens MensagemWhatsapp[]

  @@index([lojaId, createdAt])
  @@index([modeloId])
  @@map("campanhas")
}

// Campanha da MARCA (catálogo centralizado): o gestor monta uma vez no nível da rede e
// disponibiliza (ativa = true); as vendedoras disparam para a própria carteira com 1 clique.
// Cada disparo vira uma Campanha (loja) ligada a este modelo, consolidando os resultados.
model CampanhaModelo {
  id               String           @id @default(cuid())
  redeId           String
  criadaPorId      String
  nome             String
  mensagemTemplate String
  templateId       String? // template HSM (Cloud API) vinculado à campanha da marca
  segmentoAlvo     SegmentoCliente? // segmento sugerido (null = carteira toda)
  imagemUrl        String? // peça/banner (exibida no catálogo; envio pelo WhatsApp na migração oficial)
  ativa            Boolean          @default(true) // disponível para as vendedoras dispararem
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  rede      Rede       @relation(fields: [redeId], references: [id], onDelete: Cascade)
  criadaPor Usuario    @relation("ModelosCampanhaCriados", fields: [criadaPorId], references: [id])
  disparos  Campanha[]

  @@index([redeId, ativa])
  @@map("campanhas_modelo")
}

// Situação de um template HSM no ciclo de aprovação da Meta.
enum StatusTemplate {
  RASCUNHO // criado no painel, ainda não enviado à Meta
  PENDENTE // submetido à Meta, aguardando aprovação
  APROVADO // aprovado — pode ser usado em campanhas (e fora da janela de 24h)
  REJEITADO // recusado pela Meta (ver motivoRejeicao)
  PAUSADO // pausado pela Meta (queda de qualidade)
}

/// Template de mensagem (HSM) por marca para a WhatsApp Cloud API. O gestor escreve o corpo
/// com placeholders nomeados ({primeiroNome}, {loja}, {link}...); convertemos para {{1}},{{2}}
/// na Meta e guardamos a ORDEM das variáveis para montar os parâmetros no envio.
model TemplateWhatsapp {
  id             String         @id @default(cuid())
  redeId         String
  nome           String // nome de exibição (ex.: "Novidades da semana")
  metaNome       String // nome na Meta (minúsculas_com_underscore) — identificador do template
  idioma         String         @default("pt_BR")
  categoria      String         @default("MARKETING") // MARKETING | UTILITY
  corpo          String // texto com placeholders nomeados
  variaveis      Json // ordem dos placeholders → {{1}},{{2}}... ex.: ["primeiroNome","loja","link"]
  status         StatusTemplate @default(RASCUNHO)
  metaId         String? // id do template na Meta
  motivoRejeicao String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([redeId, metaNome, idioma])
  @@index([redeId, status])
  @@map("templates_whatsapp")
}

model MensagemWhatsapp {
  id          String          @id @default(cuid())
  lojaId      String
  clienteId   String?
  vendedoraId String // dona do atendimento (roteamento por carteira)
  campanhaId  String?
  grupoId     String? // disparo originado de um grupo de transmissão (lista interna)
  direcao     DirecaoMensagem
  status      StatusMensagem
  origem      OrigemMensagem  @default(MANUAL)
  telefone    String
  texto       String
  // Mídia (ex.: áudio/PTT). tipoMidia null = mensagem de texto pura.
  tipoMidia   String? // 'AUDIO' (futuro: IMAGEM, VIDEO, DOC)
  midiaUrl    String?
  // Cloud API: id da mensagem na Meta (wamid) para correlacionar os recibos (status);
  // templateNome preenchido quando o envio foi por template HSM (fora da janela de 24h).
  waMessageId String?
  templateNome String?
  createdAt   DateTime        @default(now())

  cliente   Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  vendedora Usuario           @relation("MensagensVendedora", fields: [vendedoraId], references: [id])
  campanha  Campanha?         @relation(fields: [campanhaId], references: [id], onDelete: SetNull)
  grupo     GrupoTransmissao? @relation(fields: [grupoId], references: [id], onDelete: SetNull)

  @@index([clienteId, createdAt])
  @@index([lojaId, createdAt])
  @@index([grupoId, createdAt])
  @@index([waMessageId])
  @@map("mensagens_whatsapp")
}

/// DMs do Instagram oficial (Meta) — espelha MensagemWhatsapp trocando telefone/waMessageId
/// por igScopedId/igMessageId. Sem campanha/grupo nesta entrega (só a caixa de entrada 1:1).
model MensagemInstagram {
  id          String          @id @default(cuid())
  lojaId      String
  clienteId   String?
  vendedoraId String // dona do atendimento (roteamento por carteira)
  direcao     DirecaoMensagem
  status      StatusMensagem
  origem      OrigemMensagem  @default(MANUAL)
  igScopedId  String
  texto       String
  tipoMidia   String?
  midiaUrl    String?
  igMessageId String?
  createdAt   DateTime        @default(now())

  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  vendedora Usuario  @relation("MensagensInstagramVendedora", fields: [vendedoraId], references: [id])

  @@index([clienteId, createdAt])
  @@index([lojaId, createdAt])
  @@index([igMessageId])
  @@map("mensagens_instagram")
}

// ─────────────────────────── Grupos de transmissão (Chat Zaieze) ───────────────────────────
// A API oficial da Meta não cria grupos nativos do WhatsApp. Aqui "grupo" é uma LISTA INTERNA:
// a vendedora junta clientes da carteira e dispara UMA mensagem que sai INDIVIDUAL a cada membro
// (cada cliente recebe no privado e o disparo aparece na conversa individual dele).

model GrupoTransmissao {
  id          String   @id @default(cuid())
  lojaId      String
  vendedoraId String // dona/criadora do grupo
  nome        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  loja      Loja               @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  vendedora Usuario            @relation("GruposVendedora", fields: [vendedoraId], references: [id], onDelete: Cascade)
  membros   GrupoMembro[]
  mensagens MensagemWhatsapp[]

  @@index([lojaId, vendedoraId])
  @@map("grupos_transmissao")
}

model GrupoMembro {
  grupoId   String
  clienteId String
  createdAt DateTime @default(now())

  grupo   GrupoTransmissao @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  cliente Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@id([grupoId, clienteId])
  @@index([clienteId])
  @@map("grupos_membros")
}

model ReguaInatividade {
  id               String   @id @default(cuid())
  lojaId           String
  dias             Int // 30 / 60 / 90 / 180 dias sem compra
  mensagemTemplate String
  ativa            Boolean  @default(true)
  createdAt        DateTime @default(now())

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@unique([lojaId, dias])
  @@map("reguas_inatividade")
}

// ─────────────────────────── Comissão + Gamificação ───────────────────────────

model RegraComissao {
  id             String         @id @default(cuid())
  lojaId         String
  escopo         EscopoComissao
  refId          String? // produtoId / categoriaId / marcaId (null quando PADRAO)
  percentual     Decimal        @db.Decimal(5, 2) // % base
  percentualMeta Decimal?       @db.Decimal(5, 2) // % quando a vendedora bate a meta do mês
  createdAt      DateTime       @default(now())

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@unique([lojaId, escopo, refId])
  @@index([lojaId])
  @@map("regras_comissao")
}

model PostMural {
  id        String   @id @default(cuid())
  lojaId    String
  autorId   String
  titulo    String
  conteudo  String
  imagemUrl String?
  createdAt DateTime @default(now())

  loja  Loja    @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  autor Usuario @relation(fields: [autorId], references: [id])

  @@index([lojaId, createdAt])
  @@map("posts_mural")
}

// ─────────────────────────── Programa de Afiliados ───────────────────────────
// Parceiro comercial (renda recorrente por indicação). Não pertence a nenhuma Rede/Loja —
// mesmo padrão do SUPER_ADMIN: existe só no nível da plataforma. O repasse da comissão é
// MANUAL (Pix por fora, sem integração com o Mercado Pago) — ver ComissaoAfiliado.

/// Perfil de Afiliado — 1:1 com Usuario(role=AFILIADO).
model Afiliado {
  id                 String    @id @default(cuid())
  usuarioId          String    @unique
  codigo             String    @unique // código de indicação, usado no link ?ref=<codigo>
  percentualComissao Decimal?  @db.Decimal(5, 2) // null = usa ConfigAfiliados.percentualPadrao
  chavePixTipo       String? // EMAIL | CPF | TELEFONE | ALEATORIA
  chavePix           String?
  cliques            Int       @default(0) // contador de cliques no link (não deduplicado por visitante)
  aceiteTermosVersao String?
  aceiteTermosEm     DateTime?
  aceiteTermosIp     String?
  // Enquadramento fiscal (autodeclarado pelo afiliado) — sinaliza a regra de retenção de IR/INSS
  // por tipo de parceiro; a regra em si (quanto/quando reter) precisa ser validada com contador
  // antes de virar automação — ver referências do Programa de Afiliados na memória do projeto.
  taxStatus String? // PF | PJ | MEI
  // Saúde fiscal do afiliado p/ compliance da Reforma Tributária (LC 214/2025): a plataforma pode
  // ser corresponsabilizada pelo recolhimento de IBS/CBS se o parceiro não emitir nota ou estiver
  // irregular. Hoje é um status MANUAL (o admin verifica e marca) — não há integração de NFS-e
  // automática ainda (Focus NFe é um bloqueador futuro, não implementado).
  statusFiscal             String    @default("NAO_VERIFICADO") // EM_DIA | IRREGULAR | NAO_VERIFICADO
  statusFiscalVerificadoEm DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  usuario        Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  redesIndicadas Rede[]
  comissoes      ComissaoAfiliado[]

  @@map("afiliados")
}

/// Comissão por CICLO PAGO — registro persistido e auditável (dinheiro real a repassar),
/// gerado a cada ciclo confirmado da assinatura da rede indicada. Comissão vitalícia:
/// enquanto a rede continuar pagando, todo ciclo gera uma linha nova aqui.
model ComissaoAfiliado {
  id                  String         @id @default(cuid())
  afiliadoId          String
  redeId              String // rede (cliente indicado) que gerou este ciclo pago
  redeNome            String // snapshot do nome da marca (sobrevive se a rede for excluída depois)
  cicloEm             DateTime // chave de idempotência: cicloFimEm vigente ANTES da confirmação
  valorBaseAssinatura Decimal        @db.Decimal(12, 2)
  percentualComissao  Decimal        @db.Decimal(5, 2) // snapshot do % efetivo no momento
  valorComissao       Decimal        @db.Decimal(12, 2)
  status              StatusComissao @default(PENDENTE)
  pagoEm              DateTime?
  pagoPorId           String? // id do SUPER_ADMIN que confirmou o repasse manual (Pix por fora)
  observacaoPagamento String?
  // Retenção de IBS/CBS (Reforma Tributária, LC 214/2025) registrada no repasse — informativo,
  // preenchido manualmente pelo admin quando aplicável. NÃO há cálculo automático de alíquota
  // aqui (2026 é ano de teste; regra real precisa ser validada com contador antes de automatizar).
  valorRetencaoFiscal Decimal?       @db.Decimal(12, 2)
  createdAt           DateTime       @default(now())

  afiliado Afiliado @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)

  @@unique([redeId, cicloEm])
  @@index([afiliadoId, status])
  @@map("comissoes_afiliado")
}

/// Percentual padrão de comissão (editável pelo SUPER_ADMIN, sem deploy). Uma linha só (id=1).
model ConfigAfiliados {
  id               Int      @id @default(1)
  percentualPadrao Decimal  @default(10) @db.Decimal(5, 2)
  updatedAt        DateTime @updatedAt

  @@map("config_afiliados")
}

/// Percentual padrão da comissão de INDICAÇÃO DE LOJISTAS pelo Assessor(a) de Moda (editável pelo
/// SUPER_ADMIN, sem deploy) — usado quando o assessor não tem um % individual arbitrado. Uma linha só (id=1).
model ConfigAssessorIndicacao {
  id               Int      @id @default(1)
  percentualPadrao Decimal  @default(2) @db.Decimal(5, 2)
  updatedAt        DateTime @updatedAt

  @@map("config_assessor_indicacao")
}

/// Comissão por CICLO PAGO de uma rede indicada por um Assessor(a) de Moda — mesma mecânica da
/// ComissaoAfiliado (comissão vitalícia, uma linha por ciclo confirmado), mas sem percentual
/// padrão global: cada assessora tem o % arbitrado individualmente (Assessor.percentualComissaoIndicacao).
model ComissaoAssessor {
  id                  String         @id @default(cuid())
  assessorId          String
  redeId              String // rede (lojista indicado) que gerou este ciclo pago
  redeNome            String // snapshot do nome da marca (sobrevive se a rede for excluída depois)
  cicloEm             DateTime // chave de idempotência: cicloFimEm vigente ANTES da confirmação
  valorBaseAssinatura Decimal        @db.Decimal(12, 2)
  percentualComissao  Decimal        @db.Decimal(5, 2) // snapshot do % no momento do ciclo
  valorComissao       Decimal        @db.Decimal(12, 2)
  status              StatusComissao @default(PENDENTE)
  pagoEm              DateTime?
  pagoPorId           String? // id do SUPER_ADMIN que confirmou o repasse manual (Pix por fora)
  observacaoPagamento String?
  // Retenção de IBS/CBS (Reforma Tributária, LC 214/2025) registrada no repasse — informativo,
  // sem cálculo automático de alíquota (mesmo critério da ComissaoAfiliado).
  valorRetencaoFiscal Decimal?       @db.Decimal(12, 2)
  createdAt           DateTime       @default(now())

  assessor Assessor @relation(fields: [assessorId], references: [id], onDelete: Cascade)

  @@unique([redeId, cicloEm])
  @@index([assessorId, status])
  @@map("comissoes_assessor")
}

// ─────────────────────────── Assessor(a) de Moda ───────────────────────────
// Papel sem rede/loja (como o Afiliado), mas com subdomínio PRÓPRIO (<slug>.zaieze.com):
// representa marcas de moda — algumas já clientes ZAIEZE, outras totalmente externas (só redes
// sociais/WhatsApp) — numa vitrine pública única. Toda venda é lançada manualmente por ela
// (mesmo quando a marca é cliente ZAIEZE — v1 não integra automaticamente com o funil da marca).
model Assessor {
  id        String   @id @default(cuid())
  usuarioId String   @unique
  slug      String   @unique // subdomínio próprio: <slug>.zaieze.com — único também frente a Rede.slug (checado em código, tabelas diferentes)
  plano     PlanoAssessor @default(BASICO)
  bio       String? // apresentação exibida na capa da vitrine pública
  tagline   String? // frase de efeito em destaque na vitrine (fonte script), ex.: "Conectando estilos, criando histórias."
  // Badge "Disponível"/"Offline" na vitrine. Quando seguirAgenda=true (padrão), o valor exibido
  // é CALCULADO a partir de AssessorHorario (dia da semana + horário atual, fuso America/Sao_Paulo)
  // e este campo vira só o override manual — ela pode marcar Offline fora da agenda (ex.: imprevisto)
  // desligando seguirAgenda, ou voltar a seguir a agenda normalmente.
  disponivel   Boolean @default(true)
  seguirAgenda Boolean @default(true)
  whatsapp  String? // contato pessoal dela (distinto do whatsapp de cada marca representada)
  telefone  String? // número para o botão "Ligar" (distinto do whatsapp)
  instagram String?
  site      String?
  // Estatísticas exibidas na vitrine — autodeclaradas, sem validação (só "marcas" é contagem real).
  // "Avaliação" NÃO está aqui — é calculada a partir de AssessorAvaliacao (nota real de cliente).
  statProdutos   Int?
  statClientes   Int?
  // Indicação de lojistas (link próprio ?refAssessor=<slug>): % arbitrado pelo SUPER_ADMIN por
  // assessora — null = sem indicação habilitada (nenhuma comissão é gerada até ser definido).
  percentualComissaoIndicacao Decimal? @db.Decimal(5, 2)
  cliquesIndicacao            Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  marcas  AssessorMarca[]
  vendas  VendaAssessora[]
  assinatura      AssinaturaAssessor?
  aceitesContrato AceiteContratoAssessor[]
  redesIndicadas  Rede[]
  comissoesIndicacao ComissaoAssessor[]
  horarios        AssessorHorario[]
  avaliacoes      AssessorAvaliacao[]
  lancamentos     AssessorLancamento[]

  @@map("assessores")
}

/// "Lançamento" — modelo/peça de uma marca representada que o Brand Partner escolhe destacar
/// na página de Lançamentos da vitrine pública (vitrine ordena por comissão sugerida da marca
/// primeiro — dá mais visibilidade pra quem paga mais — depois por mais recente).
model AssessorLancamento {
  id              String   @id @default(cuid())
  assessorId      String
  assessorMarcaId String
  nome            String
  fotoUrl         String?
  preco           Decimal? @db.Decimal(12, 2)
  descricao       String?  @db.VarChar(300)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assessor      Assessor      @relation(fields: [assessorId], references: [id], onDelete: Cascade)
  assessorMarca AssessorMarca @relation(fields: [assessorMarcaId], references: [id], onDelete: Cascade)

  @@index([assessorId, ativo])
  @@map("assessor_lancamentos")
}

enum StatusAvaliacaoAssessor {
  PENDENTE
  APROVADA
  RECUSADA
}

/// Avaliação de atendimento enviada pelo CLIENTE (sem login, formulário público na vitrine) —
/// nota 1-5 + comentário curto. Nasce PENDENTE; só entra na média/depoimentos públicos depois
/// que a própria Brand Partner aprova no painel (evita golpe/spam indo direto ao ar).
model AssessorAvaliacao {
  id          String                   @id @default(cuid())
  assessorId  String
  nota        Int // 1 a 5
  comentario  String?                  @db.VarChar(400)
  nomeCliente String? // opcional, texto livre (não é um Cliente cadastrado — não há login)
  status      StatusAvaliacaoAssessor  @default(PENDENTE)
  createdAt   DateTime                 @default(now())
  moderadoEm  DateTime?

  assessor Assessor @relation(fields: [assessorId], references: [id], onDelete: Cascade)

  @@index([assessorId, status])
  @@map("assessor_avaliacoes")
}

/// Agenda semanal recorrente do Brand Partner — cada linha é UM período de atendimento dentro
/// de um dia da semana (0=domingo..6=sábado); um dia pode ter vários períodos (ex.: manhã e
/// tarde, com intervalo de almoço no meio). Dia sem nenhuma linha = fechado o dia todo.
/// Usada para calcular o badge "Disponível"/"Offline" da vitrine quando Assessor.seguirAgenda=true.
model AssessorHorario {
  id         String @id @default(cuid())
  assessorId String
  diaSemana  Int // 0=domingo, 1=segunda, ..., 6=sábado
  ordem      Int    @default(0) // ordem dos períodos dentro do mesmo dia (ex.: manhã=0, tarde=1)
  inicio     String // "HH:mm", ex.: "09:00"
  fim        String // "HH:mm", ex.: "12:00"

  assessor Assessor @relation(fields: [assessorId], references: [id], onDelete: Cascade)

  @@index([assessorId, diaSemana])
  @@map("assessor_horarios")
}

/// Plano da assinatura do Brand Partner — define o limite de mídia de destaque por marca
/// representada (ver LIMITES_GALERIA em assessores.routes.ts). Ela mesma escolhe/troca no painel.
enum PlanoAssessor {
  BASICO
  AVANCADO
}

/// Um "cartão de fornecedor" representado pela assessora — campos padronizados no modelo do
/// catálogo de referência (descrição/pagamento/envio/condições em bullets, 1 item por linha).
model AssessorMarca {
  id         String  @id @default(cuid())
  assessorId String
  redeId     String? // preenchido quando a marca já é cliente ZAIEZE — hoje é só referência/selo, sem crédito automático de venda
  nome       String
  logoUrl    String?
  bannerUrl  String? // imagem grande do card na grade "Marcas que represento" (distinta da logoUrl pequena)
  descricao       String? // bullets, 1 por linha (ex.: "Fabricação própria")
  formasPagamento String? // bullets, 1 por linha (ex.: "PIX", "Cartão em até 4x")
  modoEnvio       String? // bullets, 1 por linha
  condicoesCompra String? // bullets, 1 por linha (ex.: "Mínimo 12 peças", "Não precisa CNPJ")
  tamanhos        String?
  valores         String? // texto livre (ex.: "De R$ 59,90 a R$ 299,90")
  endereco        String?
  cnpj            String?
  instagram String?
  facebook  String?
  whatsapp  String?
  telegram  String?
  tiktok    String?
  site      String?
  linkCatalogo String? // link do catálogo público de verdade da marca (quando ela é cliente ZAIEZE) — preenchido manualmente, sem vínculo automático com nenhuma vendedora
  percentualComissaoSugerido Decimal? @db.Decimal(5, 2) // pré-preenche o % ao lançar uma venda desta marca
  ordem     Int      @default(0) // ordem manual de exibição na vitrine
  ativo     Boolean  @default(true)
  // Autorização do gestor da marca — obrigatória quando redeId != null (marca já é cliente ZAIEZE).
  // Criada automaticamente (pendente) quando a rede se cadastra pelo link ?refAssessor=<slug> do
  // assessora; só entra na vitrine/catálogo depois que o gestor aceita. Marcas externas (redeId
  // null, cadastradas manualmente pela assessora) nascem já autorizadas — não há gestor para aceitar.
  autorizadoEm DateTime?
  recusadoEm   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessor Assessor              @relation(fields: [assessorId], references: [id], onDelete: Cascade)
  rede     Rede?                 @relation(fields: [redeId], references: [id], onDelete: SetNull)
  vendas   VendaAssessora[]
  midias   AssessorMarcaMidia[]
  lancamentos AssessorLancamento[]

  @@index([assessorId, ordem])
  @@map("assessor_marcas")
}

enum TipoMidiaAssessorMarca {
  FOTO
  VIDEO
}

/// Fotos/vídeo de destaque dos produtos de uma marca representada — mostrados na janela de
/// links da vitrine. Quantidade permitida por tipo depende do PlanoAssessor (ver LIMITES_GALERIA).
model AssessorMarcaMidia {
  id              String                  @id @default(cuid())
  assessorMarcaId String
  tipo            TipoMidiaAssessorMarca
  url             String
  ordem           Int                     @default(0)
  createdAt       DateTime                @default(now())

  assessorMarca AssessorMarca @relation(fields: [assessorMarcaId], references: [id], onDelete: Cascade)

  @@index([assessorMarcaId, tipo, ordem])
  @@map("assessor_marca_midias")
}

/// Lançamento manual de venda (comissão) da assessora para uma marca representada.
model VendaAssessora {
  id                 String   @id @default(cuid())
  assessorId         String
  assessorMarcaId    String
  data               DateTime // data da venda informada pela assessora (não é o createdAt)
  valorVenda         Decimal  @db.Decimal(12, 2)
  percentualComissao Decimal  @db.Decimal(5, 2)
  totalComissao      Decimal  @db.Decimal(12, 2) // = valorVenda * percentualComissao/100, congelado no lançamento (sobrevive a mudanças futuras do %)
  observacao         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assessor      Assessor      @relation(fields: [assessorId], references: [id], onDelete: Cascade)
  assessorMarca AssessorMarca @relation(fields: [assessorMarcaId], references: [id], onDelete: Cascade)

  @@index([assessorId, data])
  @@map("vendas_assessora")
}

/// Preço da assinatura mensal do plano "Assessor(a) de Moda" (página comercial) — editável
/// pelo SUPER_ADMIN no Admin. Linha única (id fixo = 1), mesmo padrão de ConfigAfiliados.
model ConfigAssessores {
  id                   Int      @id @default(1)
  precoMensalBasico    Decimal  @default(89.99) @db.Decimal(10, 2)
  precoMensalAvancado  Decimal  @default(149.99) @db.Decimal(10, 2)
  updatedAt            DateTime @updatedAt

  @@map("config_assessores")
}

/// Assinatura mensal recorrente da assessora (Mercado Pago) — mesmo padrão de AssinaturaAddon
/// (StatusAssinatura: PENDENTE até o pagamento confirmar, ATIVA, CANCELADA). Uma conta criada
/// pelo admin (sem passar pelo checkout público) simplesmente não tem este registro — login
/// livre nesse caso (ver auth.routes.ts); só bloqueia quando HÁ registro e ele não está ATIVA.
model AssinaturaAssessor {
  id                       String           @id @default(cuid())
  assessorId               String           @unique
  status                   StatusAssinatura @default(PENDENTE)
  valor                    Decimal          @db.Decimal(10, 2)
  mpPreapprovalId          String?          @unique
  simulada                 Boolean          @default(false)
  cicloFimEm               DateTime?
  cancelamentoSolicitadoEm DateTime?
  cancelamentoOrigem       String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  assessor Assessor @relation(fields: [assessorId], references: [id], onDelete: Cascade)

  @@map("assinaturas_assessor")
}

/// Aceite eletrônico do contrato do plano Assessor de Moda — registrado no cadastro (checkout
/// público), antes de seguir para o pagamento. Modelo próprio (não reaproveita AceiteContrato,
/// que é por Rede) porque a assessora não tem redeId.
model AceiteContratoAssessor {
  id             String   @id @default(cuid())
  assessorId     String
  versao         String
  assinanteNome  String
  assinanteEmail String
  ip             String?
  userAgent      String?
  aceitoEm       DateTime @default(now())

  assessor Assessor @relation(fields: [assessorId], references: [id], onDelete: Cascade)

  @@index([assessorId])
  @@map("aceites_contrato_assessor")
}

// ─────────────────────────── Provador virtual (módulo 13 — Elite) ───────────────────────────
// Fila no banco: o worker (poller) avança os looks pelos estados, chamando a FASHN e gravando
// as mídias no R2 (cdn.zaieze.com). A selfie do cliente é dado pessoal sensível: expurgada
// assim que cumpre a finalidade (foto gerada) e nunca retida além do necessário (LGPD).
model LookProvador {
  id            String         @id @default(cuid())
  redeId        String // escopo de cota/billing
  lojaId        String // escopo de mídia no R2 (lojaId/pasta)
  produtoBaseId String // a peça que o cliente vai "vestir"
  criadoPorId   String // vendedora/gestor que gerou o link
  comVideo      Boolean        @default(false)
  status        StatusProvador @default(AGUARDANDO_FOTO)

  // Link público (uso único) para o cliente enviar a selfie + consentir
  token    String   @unique @default(cuid())
  expiraEm DateTime // prazo do link (env.PROVADOR_LINK_HORAS)

  // Selfie do cliente — expurgo agressivo após a geração (LGPD)
  fotoClienteUrl         String?
  fotoClienteExpurgadaEm DateTime?
  // Consentimento LGPD do cliente (prova: quando + IP)
  consentLgpdEm DateTime?
  consentIp     String?

  // Resultados gerados
  fotoUrl  String?
  videoUrl String?
  viaIa    Boolean @default(false) // true = gerado pela FASHN; false = modo simulado
  creditos Int     @default(0) // créditos FASHN consumidos (relatório de custo)

  // Polling da FASHN
  externalFotoId  String?
  externalVideoId String?
  tentativas      Int     @default(0)
  erro            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rede      Rede    @relation(fields: [redeId], references: [id], onDelete: Cascade)
  loja      Loja    @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  produto   Produto @relation(fields: [produtoBaseId], references: [id], onDelete: Cascade)
  criadoPor Usuario @relation("LooksProvadorCriados", fields: [criadoPorId], references: [id])

  @@index([status])
  @@index([redeId, createdAt])
  @@index([lojaId, createdAt])
  @@map("looks_provador")
}
